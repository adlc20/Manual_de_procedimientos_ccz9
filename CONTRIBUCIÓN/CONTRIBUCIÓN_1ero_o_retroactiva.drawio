        <mxCell id="jZZ3yj90uL_3dCCTneKZ-45" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2) &lt;b&gt;Acceder al ítem &quot;inmobiliario&quot;&lt;/b&gt; - &lt;b&gt;&quot;solicitud de exoneración/subsidios jubilados&quot;&lt;/b&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;(cliquear &quot;linterna&quot;):&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;ol&gt;&lt;li&gt;&lt;b&gt;Ingresar&lt;/b&gt; el &lt;b&gt;número de cuenta corriente &lt;/b&gt;del impuesto (cliquear &quot;linterna&quot;)&lt;/li&gt;&lt;li&gt;Buscar el n&lt;b&gt;ombre del solicitante&lt;/b&gt;&amp;nbsp;&lt;b&gt;cliqueando&amp;nbsp;&lt;/b&gt;en el &lt;b&gt;símbolo de flechita azul &quot;persona física&quot; e ingresamos la cédula&lt;/b&gt; correspondiente&amp;nbsp;&lt;/li&gt;&lt;li&gt;Cliquear &lt;b&gt;si corresponde &quot;Art10 Dcto 36852 Invalidez o Jubil. incapacidad TOTAL&quot;&lt;/b&gt; (varían los márgenes)&lt;/li&gt;&lt;li&gt;&amp;nbsp;Si el &lt;b&gt;sistema permite continuar&lt;/b&gt; (el valor imponible esta dentro de los márgenes dispuestos). &lt;b&gt;Cliquear &quot;datos exoneración&quot;&amp;nbsp;&amp;nbsp;&lt;/b&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="471" width="620" x="2596" y="2061" as="geometry" />
        </mxCell>
        <mxCell id="jZZ3yj90uL_3dCCTneKZ-46" edge="1" parent="1" source="jZZ3yj90uL_3dCCTneKZ-47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3;fillColor=#60a917;strokeColor=#2D7600;" target="jZZ3yj90uL_3dCCTneKZ-75">
