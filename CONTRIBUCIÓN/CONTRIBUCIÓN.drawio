        <mxCell id="j44Z1A3Amum-UeW5LigI-47" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="&lt;div&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;1)&lt;b&gt; Acceder a &quot;consultas generales&quot; - &quot;contribución inmobiliaria&quot; - &quot;cuentas por unidad catastral&quot;:&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;ol&gt;&lt;li&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp;(cliquear &quot;linterna&quot;) Ingresar el &lt;b&gt;número de padrón&lt;/b&gt; correspondiente&amp;nbsp;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Validar&lt;/b&gt; que el solicitante &lt;b&gt;no&lt;/b&gt; &lt;b&gt;tenga&lt;/b&gt; &lt;b&gt;más de un tributo domiciliario&lt;/b&gt;, &lt;b&gt;que no sea baldío&lt;/b&gt;, &lt;b&gt;que no cuente con&lt;/b&gt; &lt;b&gt;contribución rural&lt;/b&gt; &lt;b&gt;ni&lt;/b&gt; con &lt;b&gt;actividad comercial&lt;/b&gt;.&amp;nbsp;&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="572.16" x="432.0000000000002" y="1516" as="geometry" />
        </mxCell>
        <mxCell id="j44Z1A3Amum-UeW5LigI-48" edge="1" parent="1" source="j44Z1A3Amum-UeW5LigI-49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#60a917;strokeColor=#2D7600;strokeWidth=3;" target="j44Z1A3Amum-UeW5LigI-39">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="j44Z1A3Amum-UeW5LigI-49" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;En el ítem &quot;Datos exoneración&quot;&lt;/b&gt; :&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;1)&lt;b&gt; Des-cliquear si no trae timbre profesional&lt;/b&gt; (se genera uno en el mismo CCZ y se le cobrará en el mes de noviembre del presente año)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;2) &lt;b&gt;Ingresar datos&lt;/b&gt; como:&lt;/span&gt;&lt;br&gt;&lt;ul&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Cantidad de titulares y porcentaje del bien&lt;/b&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Fecha de adquisición&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Número sem.&lt;/b&gt; (expediente)&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Unidad de ingreso (3310) y cliquear &quot;Tab.&quot;&lt;/b&gt;&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Ingresos del beneficiario, conyugue y el resto del núcleo familiar. Luego cliquear &quot;suma total&quot;&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;(el sistema indicará el porcentaje de exoneración aplicable a la participación del solicitante)&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 20px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; 3) &lt;b&gt;Aclarar observaciones y cliquear &quot;volver&quot;&lt;/b&gt;&lt;/span&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 20px;&quot;&gt;&amp;nbsp;(el sistema evalúa si cumple los requisitos)&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="351" width="780" x="224.15999999999997" y="2534" as="geometry" />
        </mxCell>
        <mxCell id="j44Z1A3Amum-UeW5LigI-50" edge="1" parent="1" source="j44Z1A3Amum-UeW5LigI-51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#60a917;strokeColor=#2D7600;strokeWidth=3;" target="j44Z1A3Amum-UeW5LigI-61">
