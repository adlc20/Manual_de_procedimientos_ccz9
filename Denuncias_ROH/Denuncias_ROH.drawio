        <mxCell id="TdNUSkhpH6wEshkDsbPW-40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fontSize=25;roundedPerimeter=1;shadow=1;" value="&lt;span&gt;Estos casos&lt;b&gt; no son competencia &lt;/b&gt;de la &lt;b&gt;IMM&lt;/b&gt;. Medidas que pueden tomar:&lt;/span&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span&gt;Denuncia civil en Seccional Policial&amp;nbsp;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;Defensoría del vecino (0800 1616)&amp;nbsp;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;Centro de mediación vecinal&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
