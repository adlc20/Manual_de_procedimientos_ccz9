        <mxCell id="-ugGauVV3H63w-q64Dkx-10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;font-size: 25px;&quot;&gt;Declaración Jurada:&amp;nbsp; Si el ciudadano no tiene una declaración jurada vigente, se le ingresa una nueva en el sistema.&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Declaración jurada: dirección y datos de la vivienda (puerta, esquina, etc.). Completa los datos generales: ingresos, egresos, composición familiar, cantidad de pozos, etc.)&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="323.5" width="619" x="1209" y="726.75" as="geometry" />
        </mxCell>
        <mxCell id="-ugGauVV3H63w-q64Dkx-64" edge="1" parent="1" source="-ugGauVV3H63w-q64Dkx-16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;fillColor=#60a917;strokeColor=#2D7600;strokeWidth=2;" target="-ugGauVV3H63w-q64Dkx-63">
