        <mxCell id="7YQFB75yd-6R1-LgeEUD-12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;fontSize=25;" value="&lt;font&gt;&lt;b&gt;Completar&lt;/b&gt; los siguientes ítems:&lt;/font&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;font&gt;&lt;b&gt;CCZ 9&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font&gt;&lt;b&gt;Número de expediente &lt;/b&gt;(sin guiones)&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font&gt;En el campo&lt;b&gt; &quot;Rubro&quot;&lt;/b&gt;, cliquear en la flecha azul el ítem: &lt;b&gt;&quot;Papel timbrado CCZ&quot;&lt;/b&gt;&amp;nbsp;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font&gt;Cliquear&lt;b&gt; &quot;generar debito&quot; e imprimir&lt;/b&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;span&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;El ciudadano debe abonar la factura para continuar con el trámite&lt;/b&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
