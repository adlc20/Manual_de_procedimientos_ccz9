        <mxCell id="f2iXZMbjhmyNsFbnRmrR-5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;¿En qué &lt;b&gt;meses&lt;/b&gt;&lt;b&gt;&amp;nbsp;se puede&lt;/b&gt; &lt;b&gt;solicitar&lt;/b&gt;?&lt;/font&gt;" vertex="1">
          <mxGeometry height="77" width="270" x="545" y="301" as="geometry" />
        </mxCell>
        <mxCell id="f2iXZMbjhmyNsFbnRmrR-6" edge="1" parent="1" source="f2iXZMbjhmyNsFbnRmrR-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.003;exitY=0.398;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fillColor=#60a917;strokeColor=#2D7600;strokeWidth=3;exitPerimeter=0;" target="f2iXZMbjhmyNsFbnRmrR-13">
          <mxGeometry relative="1" as="geometry">
