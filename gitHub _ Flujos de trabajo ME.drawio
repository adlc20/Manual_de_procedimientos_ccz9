        <mxCell id="f2iXZMbjhmyNsFbnRmrR-46" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="&lt;div&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;1)&lt;b&gt; Acceder a &quot;consultas generales&quot; - &quot;contribución inmobiliaria&quot; - &quot;cuentas por unidad catastral&quot;:&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;ol&gt;&lt;li&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp;(cliquear &quot;linterna&quot;) Ingresar el &lt;b&gt;número de padrón&lt;/b&gt; correspondiente&amp;nbsp;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Validar&lt;/b&gt; que el solicitante &lt;b&gt;no&lt;/b&gt; &lt;b&gt;tenga&lt;/b&gt; &lt;b&gt;más de un tributo domiciliario&lt;/b&gt;, &lt;b&gt;que no sea baldío&lt;/b&gt;, &lt;b&gt;que no cuente con&lt;/b&gt; &lt;b&gt;contribución rural&lt;/b&gt; &lt;b&gt;ni&lt;/b&gt; con &lt;b&gt;actividad comercial&lt;/b&gt;.&amp;nbsp;&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="572.16" x="435.0000000000002" y="1501" as="geometry" />
        </mxCell>
        <mxCell id="f2iXZMbjhmyNsFbnRmrR-47" edge="1" parent="1" source="f2iXZMbjhmyNsFbnRmrR-48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#60a917;strokeColor=#2D7600;strokeWidth=3;" target="f2iXZMbjhmyNsFbnRmrR-38">
