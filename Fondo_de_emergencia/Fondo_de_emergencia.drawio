        <mxCell id="aQtatE1oudzt1sL0k43Z-69" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 25px;&quot;&gt;Nos comunicamos con el ciudadano para cerciorarse que los materiales fueron entregados correctamente &lt;/font&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="658" x="4112" y="1318.5" as="geometry" />
        </mxCell>
        <mxCell id="aQtatE1oudzt1sL0k43Z-76" edge="1" parent="1" source="aQtatE1oudzt1sL0k43Z-73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=page;" target="aQtatE1oudzt1sL0k43Z-75">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aQtatE1oudzt1sL0k43Z-73" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 25px;&quot;&gt;Adjuntamos el remito a la bandeja de Fondo Nacional de Emergencia (5044).&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;Actualizamos la planilla de seguimiento de material&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="122.5" width="658" x="4112" y="1548" as="geometry" />
        </mxCell>
        <mxCell id="aQtatE1oudzt1sL0k43Z-78" edge="1" parent="1" source="aQtatE1oudzt1sL0k43Z-75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=page;" target="aQtatE1oudzt1sL0k43Z-77">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aQtatE1oudzt1sL0k43Z-75" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 25px;&quot;&gt;Enviamos a plazo por 30 días el expediente en la bandeja (Despacho plazos - 1256)&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;habiéndole avisado anteriormente al ciudadano que cuenta con esos días para la ejecución de la obra&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="122.5" width="658" x="4112" y="1776" as="geometry" />
        </mxCell>
        <mxCell id="aQtatE1oudzt1sL0k43Z-84" edge="1" parent="1" source="aQtatE1oudzt1sL0k43Z-77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=page;" target="aQtatE1oudzt1sL0k43Z-79">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aQtatE1oudzt1sL0k43Z-77" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;font-size: 25px;&quot;&gt;Pasado ese plazo, el expediente vuelve a la bandeja de Fondo Nacional de Emergencia (5025) y un funcionario se comunica con el ciudadano para cerciorarse si este utilizó los materiales&lt;/span&gt;" vertex="1">
          <mxGeometry height="122.5" width="658" x="4112" y="1989" as="geometry" />
        </mxCell>
        <mxCell id="aQtatE1oudzt1sL0k43Z-89" edge="1" parent="1" source="aQtatE1oudzt1sL0k43Z-79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;defaultLabelBackgroundColor=page;" target="aQtatE1oudzt1sL0k43Z-87">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aQtatE1oudzt1sL0k43Z-92" edge="1" parent="1" source="aQtatE1oudzt1sL0k43Z-79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;defaultLabelBackgroundColor=page;" target="aQtatE1oudzt1sL0k43Z-91">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aQtatE1oudzt1sL0k43Z-79" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=25;" value="¿La obra fue ejecutada?" vertex="1">
          <mxGeometry height="125" width="352" x="4265" y="2195" as="geometry" />
        </mxCell>
        <mxCell id="aQtatE1oudzt1sL0k43Z-87" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;font-size: 25px;&quot;&gt;Pase a equipo de conducción (dirección). Se le comunica al ciudadano que tiene 30 días más para realizar las obras.&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Pasados esos días, si se utilizaron va al camino del SI, si aún no los usan pase a equipo de conducción (dirección)&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170.75" width="658" x="3749" y="2349" as="geometry" />
        </mxCell>
        <mxCell id="aQtatE1oudzt1sL0k43Z-91" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;font-size: 25px;&quot;&gt;Si se pasa al área de aquitectura, bandeja común (arquitectura y urbanismo) y verificar la utilización de materiales con recorrido.&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;finaliza el expediente&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="141.5" width="658" x="4482" y="2355" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
