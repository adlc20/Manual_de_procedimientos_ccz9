        <mxCell id="eN__Utglt0hpf8qCz9KJ-22" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;font-size: 25px;&quot;&gt;Con los datos proporcionados el área de inspección genera el expediente (sistema SEE) en la unidad:&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;FONDO HABITACIONAL DE EMERGENCIA - 5025&lt;/span&gt;&lt;/div&gt;" vertex="1">
