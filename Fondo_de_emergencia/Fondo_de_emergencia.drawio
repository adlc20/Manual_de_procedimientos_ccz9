        <mxCell id="eN__Utglt0hpf8qCz9KJ-26" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;u&gt;Asunto: &lt;/u&gt;&quot;Emergencia por siniestro: (incendio, derrumbe, etc.). Adjuntar brevemente datos del ciudadano como del caso&quot;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;u&gt;Tipo:&lt;/u&gt; &quot;Fondo solidario de materiales para mejora de vivienda - solicitud de&quot;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;u&gt;Clasificación de información:&lt;/u&gt; Pública&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;u&gt;Solicitud de acceso: &lt;/u&gt;No&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
