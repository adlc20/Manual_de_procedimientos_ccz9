        </mxCell>
        <mxCell id="LvFLd0KWtNC7TkQydqGK-5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=25;" value="&lt;span&gt;¿Qué &lt;b&gt;requisitos &lt;/b&gt;debe cumplir el ciudadano?&lt;/span&gt;" vertex="1">
