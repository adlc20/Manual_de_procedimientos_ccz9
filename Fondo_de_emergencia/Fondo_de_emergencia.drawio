        <mxCell id="eN__Utglt0hpf8qCz9KJ-16" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;i&gt;El fondo brinda soluciones materiales de emergencia a familiares en situación de vulnerabilidad habitacional grave, ocasionada por eventos climáticos, incendios, derrumbes o situaciones de violencia doméstica y de género, entre otros imprevistos&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="103" width="2796" x="1031" y="310" as="geometry" />
        </mxCell>
