        <mxCell id="eN__Utglt0hpf8qCz9KJ-20" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;font-size: 25px;&quot;&gt;El área de arquitectura o social (indistintamente) se comunica con el ciudadano y visita la vivienda para constatar y estudiar lo sucedido&lt;/span&gt;" vertex="1">
          <mxGeometry height="122.5" width="577" x="2008.5" y="550.25" as="geometry" />
