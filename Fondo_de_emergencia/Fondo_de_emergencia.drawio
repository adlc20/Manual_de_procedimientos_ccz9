        <mxCell id="eN__Utglt0hpf8qCz9KJ-13" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=25;" value="¿En que casos el fondo brinda soluciones por emergencia habitacional&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;?&lt;/span&gt;" vertex="1">
          <mxGeometry height="125" width="352" x="-543" y="1575.88" as="geometry" />
        </mxCell>
        <mxCell id="eN__Utglt0hpf8qCz9KJ-14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;" value="&lt;br&gt;&lt;div&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;- Consecuencia de eventos climáticos adversos&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;- Incedios&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;-Derrumbes&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 25px; color: rgb(255, 0, 0);&quot;&gt;-Situaciones de violencia doméstica y de género&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;o demás imprevistos con grave riesgo habitacional&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210.75" width="592" x="-62" y="1533" as="geometry" />
        </mxCell>
        <mxCell id="eN__Utglt0hpf8qCz9KJ-15" parent="1" style="verticalLabelPosition=bottom;verticalAlign=middle;html=1;shape=mxgraph.basic.patternFillRect;step=5;fillStrokeWidth=0.2;fillStrokeColor=#dddddd;fillColor=#EDF2F7;strokeWidth=0;dashed=1;dashPattern=1 4;rounded=1;align=center;fontFamily=Helvetica;fontSize=12;fontColor=#2D3748;" value="" vertex="1">
