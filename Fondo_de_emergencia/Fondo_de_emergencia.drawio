        <mxCell id="eN__Utglt0hpf8qCz9KJ-28" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;font-size: 25px;&quot;&gt;Se da pase a Despacho a decretar (7651) y luego a las áreas de Arquitectura (5577) y Social (5578)&lt;/span&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/span&gt;" vertex="1">
