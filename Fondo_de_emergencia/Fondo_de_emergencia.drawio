        <mxCell id="aQtatE1oudzt1sL0k43Z-62" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 25px;&quot;&gt;Se hace el reclamo a la barraca y se envía nuevamente a plazo el expediente, a la bandeja 5044, nuevamente por 5 días.&amp;nbsp;&lt;/font&gt;" vertex="1">
          <mxGeometry height="122.5" width="558" x="3458" y="1433" as="geometry" />
        </mxCell>
        <mxCell id="aQtatE1oudzt1sL0k43Z-74" edge="1" parent="1" source="aQtatE1oudzt1sL0k43Z-69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=page;" target="aQtatE1oudzt1sL0k43Z-73">
