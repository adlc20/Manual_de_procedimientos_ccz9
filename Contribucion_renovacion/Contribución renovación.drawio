        <mxCell id="v-ul_ijq3pyqzExB8Hsp-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;text-align: center; font-size: 20px;&quot;&gt;&lt;b&gt;Acceder al ítem &quot;inmobiliario&quot;&lt;/b&gt; -&lt;b&gt; &quot; renovación&amp;nbsp; de exoneración/subsidios jubilados&quot;&lt;/b&gt;&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 20px; text-align: center; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;(cliquear &quot;linterna&quot;):&lt;/span&gt;&lt;/div&gt;&lt;ol&gt;&lt;li&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Ingresar número de cuenta corriente&lt;/b&gt; del impuesto (cliquear &quot;linterna&quot;)&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp;Buscar el&amp;nbsp;&lt;b&gt;nombre del solicitante&lt;/b&gt;: cliqueando en el &lt;b&gt;símbolo de flechita azul &quot;persona física&quot; e ingresamos la cédula &lt;/b&gt;correspondiente&amp;nbsp;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp;Cliquear &lt;b&gt;si corresponde &quot;Art10 Dcto 36852 Invalidez o Jubil. incapacidad TOTAL&quot;&lt;/b&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
