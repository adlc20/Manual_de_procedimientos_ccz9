        <mxCell id="YaLXAKDGUNQ4cMJmnPIx-11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 35px;&quot;&gt;MEDIANTE ESTE TRÁMITE SE SOLICITA EL PREMISO O LA REGULACIÓN DE OBRAS PARA EL REBAJE DE CORDÓN. LA OBRA LA DEBE REALIZAR LA PERSONA QUE SOLICITA EL PERMISO&amp;nbsp;&lt;/font&gt;" vertex="1">
