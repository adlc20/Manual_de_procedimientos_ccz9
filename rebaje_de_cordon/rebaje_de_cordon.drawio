          <mxGeometry height="154" width="3297" x="692" y="155" as="geometry" />
        </mxCell>
        <mxCell id="yS_hiq7C13J4Ko_sqj---1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=12 12;fillColor=#f5f5f5;fillStyle=solid;fontColor=#333333;strokeColor=#666666;" value="&lt;font style=&quot;font-size: 35px;&quot;&gt;&lt;b&gt;MEDIANTE ESTE TRÁMITE SE SOLICITA EL PERMISO O LA REGULACIÓN DE OBRAS PARA EL REBAJE DE CORDÓN&amp;nbsp;&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 35px;&quot;&gt;&lt;b&gt;(la obra la realiza la persona que solicita el premiso)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="124" width="3297" x="692" y="309" as="geometry" />
        </mxCell>
        <mxCell id="6cMRmCnC5e06KHcOmiG7-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;align=center;verticalAlign=middle;" value="&lt;ol&gt;&lt;li&gt;&lt;font style=&quot;font-size: 35px;&quot;&gt;&lt;b&gt;El acceso vehicular al predio no debe tener muro, reja ni otro impedimento.&lt;/b&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 35px; background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193));&quot;&gt;Debe haber &lt;b&gt;espacio suficiente para que el vehículo quede íntegramente estacionado dentro del predio sin ocupar la vereda&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="315" width="1224" x="692" y="1141" as="geometry" />
        </mxCell>
        <mxCell id="NoZcHgD9BgBodgeLkjVR-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 35px;&quot;&gt;&lt;b&gt;¿Qué condición debe cumplir el predio para que&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 35px;&quot;&gt;&lt;b&gt;se pueda iniciar este trámite?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="94" width="1224" x="692" y="1047" as="geometry" />
        </mxCell>
        <mxCell id="I_1Nkb-RYfn_ibrowQ9U-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 35px;&quot;&gt;&lt;b&gt;¿Qué requisito debe cumplir el ciudadano y qué debe presentar ante la IMM?&lt;/b&gt;&lt;br&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="94" width="1960" x="2029" y="534" as="geometry" />
        </mxCell>
        <mxCell id="I_1Nkb-RYfn_ibrowQ9U-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;align=center;verticalAlign=middle;" value="&lt;span style=&quot;font-size: 35px; background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193));&quot;&gt;&lt;b&gt;Ser propietario, inquilino o gestor.&lt;/b&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 35px; background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193));&quot;&gt;&amp;nbsp;&lt;b&gt;Presentar recibo de contribución inmobiliaria&lt;/b&gt; con la cuota vigente al día, en caso de estar exonerado del pago se debe presentar resolución que aclaré la exoneración&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="316.5" width="1960" x="2029" y="631.5" as="geometry" />
        </mxCell>
        <mxCell id="ZkeYRbS_75K_l63M-HyE-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;font-size: 35px;&quot;&gt;&lt;b&gt;¿Dónde se genéra este trámite?&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="94" width="1233" x="692" y="534" as="geometry" />
        </mxCell>
        <mxCell id="jPSY39YtLXHeHG_CsGpR-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;align=center;verticalAlign=middle;" value="&lt;div&gt;&lt;span style=&quot;font-size: 35px;&quot;&gt;En &lt;b&gt;Servicio de Mantenimiento Vial&lt;/b&gt; (Av. 18 de Julio 1360, puerta 7001).&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 35px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 35px;&quot;&gt;&lt;b&gt;Reservar día y hora &lt;/b&gt;llamando al 1950 4600 o 1950 4590&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 35px;&quot;&gt;(trámite con costo)&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="318.25" width="1233" x="692" y="629.75" as="geometry" />
        </mxCell>
        <mxCell id="c8KmTyo5OiP2GXddvs6M-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;align=center;verticalAlign=middle;" value="&lt;font style=&quot;font-size: 35px;&quot;&gt;- En &lt;b&gt;propiedades horizontales&lt;/b&gt; deberán presentar &lt;b&gt;constancia con el aval de la mayoría de los propietarios&lt;/b&gt; o copia del acta en caso de que se haya resuelto por asamblea.&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 35px;&quot;&gt;- En &lt;b&gt;obras nuevas&lt;/b&gt; presentar &lt;b&gt;copia del plano donde se proyectan los rebajes de cordón&lt;/b&gt; a solicitar, sellado por arquitecto y el Servicio de Contralor de la Edificación&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 35px;&quot;&gt;- Para&lt;b&gt; estacionamientos frontales en retiros de locales&lt;/b&gt; comerciales gestionar previamente reserva &lt;b&gt;ante el Servicio de Regulación Territorial de las Implantaciones&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="378" width="1960" x="2029" y="1456" as="geometry" />
        </mxCell>
