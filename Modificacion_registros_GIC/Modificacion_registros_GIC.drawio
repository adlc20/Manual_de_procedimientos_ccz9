        <mxCell id="3k5eMLGs_hdGue86psB8-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;" value="&lt;div&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;En el ítem&lt;b&gt; &quot;Números para comunicación&quot;&lt;/b&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;1) En el campo&lt;b&gt; &quot;Tipo&quot;&lt;/b&gt; cliquear la &lt;b&gt;&quot;flechita azul&quot;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;2&lt;b&gt;) Elegir el termino&lt;/b&gt; a modificar&lt;b&gt; (cédula, mail-internet, teléfono)&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;3) &lt;b&gt;Escribimos el nuevo dato&lt;/b&gt; a modificar&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;4) Salimos (&lt;b&gt;cliquear &quot;atrás&quot;&lt;/b&gt;)&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;5) Del cartel de verificación,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 25px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;cliquear &lt;b&gt;&quot;guardar&quot;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 25px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="376" width="549.25" x="3098" y="416" as="geometry" />
        </mxCell>
